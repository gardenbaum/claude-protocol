{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platform": "github",
  "autodiscover": true,
  "autodiscoverFilter": [
    "gardenbaum/*",
    "!gardenbaum/postcards",
    "!gardenbaum/wtfis",
    "!gardenbaum/all-in-one-wp-migration"
  ],
  "forkProcessing": "enabled",
  "onboarding": false,
  "requireConfig": "optional",
  "extends": ["config:recommended"],
  "timezone": "Europe/Zurich",
  "dependencyDashboardApproval": true,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "claude-protocol gets automatic PR creation (no dashboard approval)",
      "matchRepositories": ["gardenbaum/claude-protocol"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Pin Python to 3.12 line — newer majors stay on dashboard",
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.13"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
